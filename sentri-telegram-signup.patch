+                  maxLength: 20,
+                  autofocus: true,
+                  onChanged: (_) {
+                    if (_error != null) setState(() => _error = null);
+                  },
+                  onSubmitted: (_) => unawaited(_save()),
+                ),
+                if (_error != null) ...[
+                  const SizedBox(height: 8),
+                  Text(_error!, style: TextStyle(fontSize: 13, height: 1.3, color: cs.error)),
