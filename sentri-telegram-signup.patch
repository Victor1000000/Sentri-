+            ),
+            const SizedBox(width: 6),
+            Expanded(child: Text(t(trendKey), style: TextStyle(fontSize: 13, height: 1.35, color: Flat.muted(context)))),
+          ]),
+        ],
+      ]),
+    );
+  }
