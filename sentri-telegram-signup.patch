new file mode 100644
--- /dev/null
+++ b/mobile/lib/features/location/location.dart
@@ -0,0 +1,126 @@
+import 'dart:async';
+
+import 'package:geolocator/geolocator.dart';
+
+import '../../core/net/api.dart';
+
+/// How often to ask for a fix, and how precisely, while an alert is running.
+class LocationPlan {
+  const LocationPlan({required this.interval, required this.highAccuracy});
+  final Duration interval;
+  final bool highAccuracy;
+}
+
+/// Adaptive tracking: report often when the battery is healthy, back off as it drains, and back off
+/// further in data-saver mode. The goal is that the phone lasts as long as the emergency does.
+LocationPlan locationPlan({required int batteryPct, required bool dataSaver}) {
+  int seconds;
+  bool high = true;
+  if (batteryPct > 30) {
+    seconds = 10;
+  } else if (batteryPct > 15) {
+    seconds = 20;
+  } else if (batteryPct > 8) {
+    seconds = 40;
+    high = false;
+  } else {
+    seconds = 60;
+    high = false;
+  }
+  if (dataSaver) seconds = (seconds * 2).clamp(20, 120);
+  return LocationPlan(interval: Duration(seconds: seconds), highAccuracy: high);
+}
+
+/// True when a fix is a real GPS-grade position, not a rough tower/Wi-Fi guess.
+/// Movement tracking must only sum distances between fixes this good, otherwise
+/// drifting readings silently add hundreds of phantom metres.
+bool usableForDistance(GeoFix f, {double limitM = 30}) => (f.accuracyM ?? double.infinity) <= limitM;
+
+/// Where fixes come from. A fake implements this in tests.
+abstract class LocationSource {
+  /// A fresh fix, or null if none could be had within [timeout].
+  Future<GeoFix?> fix({required bool highAccuracy, required Duration timeout});
+
+  /// The OS's cached last fix; instant but possibly old.
+  Future<GeoFix?> lastKnown();
+
+  /// Like [fix], but lets the GPS settle and returns the best reading it got. A phone's first reading is often a rough
+  /// one from Wi-Fi or mobile towers; the GPS needs a few seconds to do better. For screens where being exact matters
+  /// more than being instant (the map). Alerts keep using [fix], which is quick.
+  Future<GeoFix?> preciseFix({Duration timeout = const Duration(seconds: 25)}) => fix(highAccuracy: true, timeout: timeout);
+}
+
+class GeolocatorSource implements LocationSource {
+  @override
+  Future<GeoFix?> fix({required bool highAccuracy, required Duration timeout}) async {
+    try {
+      final p = await Geolocator.getCurrentPosition(
+        locationSettings: LocationSettings(
+          accuracy: highAccuracy ? LocationAccuracy.high : LocationAccuracy.medium,
+          timeLimit: timeout,
+        ),
+      );
+      return _toFix(p);
+    } on TimeoutException {
+      return null;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// A reading this good (in metres) is as good as a phone gets outdoors, so there is no
+  /// need to wait longer. 8 m was measured too strict on real phones: the pinpoint kept
+  /// waiting for a perfect satellite pass the phone never gives. But 15 m was measured too
+  /// LOOSE on inexpensive phones: their first satellite pass can sit far off, actually
+  /// feeling like "about 300 m wrong" to the person. 10 m keeps the honest fast-fix
+  /// behaviour while refusing the first rough pass when the GPS can do better within the
+  /// caller's timeout.
+  static const _goodEnoughM = 10.0;
+
+  /// A fix worse than this is a tower/Wi-Fi guess, not a position. preciseFix holds it
+  /// back unless the timeout runs out with nothing better - a rough area beats nothing.
+  static const _uselessM = 120.0;
+
+  @override
+  Future<GeoFix?> preciseFix({Duration timeout = const Duration(seconds: 25)}) async {
+    GeoFix? best;
+    final done = Completer<void>();
+    StreamSubscription<Position>? sub;
+    try {
+      sub = Geolocator.getPositionStream(
+        locationSettings: const LocationSettings(accuracy: LocationAccuracy.bestForNavigation, distanceFilter: 0),
+      ).listen(
+        (p) {
+          final f = _toFix(p);
+          final acc = f.accuracyM ?? double.infinity;
+          if (best == null || acc < (best!.accuracyM ?? double.infinity)) best = f;
+          if (acc <= _goodEnoughM && !done.isCompleted) done.complete();
+        },
+        onError: (Object _) {
+          if (!done.isCompleted) done.complete();
+        },
+        onDone: () {
+          if (!done.isCompleted) done.complete();
+        },
+      );
+      await Future.any<void>([done.future, Future<void>.delayed(timeout)]);
+    } catch (_) {
+      // fall through with whatever was read
+    } finally {
+      await sub?.cancel();
+    }
+    return best;
+  }
+
+  @override
+  Future<GeoFix?> lastKnown() async {
+    try {
+      final p = await Geolocator.getLastKnownPosition();
+      return p == null ? null : _toFix(p);
+    } catch (_) {
+      return null;
+    }
+  }
+
+  GeoFix _toFix(Position p) => GeoFix(lat: p.latitude, lon: p.longitude, accuracyM: p.accuracy, at: p.timestamp);
+}
diff --git a/mobile/lib/features/push/push_service.dart b/mobile/lib/features/push/push_service.dart
new file mode 100644
--- /dev/null
+++ b/mobile/lib/features/push/push_service.dart
@@ -0,0 +1,352 @@
+import 'dart:async';
+import 'dart:typed_data';
+
+import 'package:firebase_core/firebase_core.dart';
+import 'package:firebase_messaging/firebase_messaging.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart' show PlatformException;
+import 'package:flutter_local_notifications/flutter_local_notifications.dart';
+import 'package:permission_handler/permission_handler.dart';
+
+import '../../core/net/api.dart';
+
+final _local = FlutterLocalNotificationsPlugin();
+
+const _channel = AndroidNotificationChannel(
+  'sentri_alerts',
+  'Sentri alerts',
+  description: 'Emergency alerts from people who chose you as a contact.',
+  importance: Importance.max,
+  enableVibration: true,
+  playSound: true,
+);
+
+/// Location-sharing updates are important but not an emergency, so they do not ring like one.
+const _shareChannel = AndroidNotificationChannel(
+  'sentri_shares',
+  'Location sharing',
+  description: 'When someone starts or stops sharing their location with you.',
+  importance: Importance.high,
+);
+
+/// Health notes (heart-rate warnings, drink-water reminders): noticeable, but they never
+/// ring like an emergency, because they are not one.
+const _healthChannel = AndroidNotificationChannel(
+  'sentri_health',
+  'Health',
+  description: 'Drink-water reminders and gentle heart-rate notes from your own Health tab.',
+  importance: Importance.high,
+);
+
+final _alarmPattern = Int64List.fromList([0, 700, 300, 700, 300, 700, 300, 700]);
+
+/// One notification per alert: repeats of the same alert replace it (and ring again) instead of piling up.
+int _idFor(Map<String, dynamic> data) => ((data['inboxId'] ?? data['sosId'] ?? data['text'] ?? '').toString().hashCode) & 0x7fffffff;
+
+/// Fixed ids so each kind can cancel or replace exactly itself.
+const _waterId = 7201;
+const _healthNoteId = 7202;
+
+/// The honest state of the drink-water reminder on this phone, as the app can verify it:
+/// * [off] - the person has not chosen a pace (or chose "off").
+/// * [ok] - the reminder really is scheduled and the phone allows notifications.
+/// * [noPermission] - the phone blocks Sentri's notifications entirely.
+/// * [notScheduled] - notifications are allowed but the recurring alarm did not stick
+///   (purged by a battery saver / reboot) or the phone has not excused Sentri from
+///   battery saving, so the reminder may silently die.
+enum WaterStatus { off, ok, noPermission, notScheduled }
+
+/// Checks what actually became of the reminder on this phone instead of assuming it
+/// works: is the notification permission granted, is the recurring alarm still among
+/// the phone's pending scheduled notifications, and has the phone excused Sentri from
+/// battery saving (without which many phones quietly drop scheduled alarms).
+Future<WaterStatus> waterReminderStatus(int minutes) async {
+  if (minutes <= 0) return WaterStatus.off;
+  try {
+    final android = _local.resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>();
+    var enabled = true;
+    try {
+      final a = await android?.areNotificationsEnabled();
+      if (a == false) enabled = false;
+    } catch (_) {}
+    if (!enabled) return WaterStatus.noPermission;
+    var scheduled = false;
+    try {
+      final pending = await _local.pendingNotificationRequests();
+      scheduled = pending.any((p) => p.id == '$_waterId');
+    } catch (_) {}
+    var batteryOk = true;
+    try {
+      batteryOk = await Permission.ignoreBatteryOptimizations.isGranted;
+    } catch (_) {}
+    if (!scheduled || !batteryOk) return WaterStatus.notScheduled;
+    return WaterStatus.ok;
+  } catch (_) {
+    // If even the check fails, say the reminder is not verified rather than pretend.
+    return WaterStatus.notScheduled;
+  }
+}
+
+/// Repeats the drink-water reminder at the person's own pace. Cancels the previous one first
+/// (including "off"), then asks for the notification permission once, right when the person
+/// turns reminders on.
+///
+/// The quiet problem this fights: phones purge scheduled alarms (reboot, battery saving,
+/// "auto-start" managers), so a reminder set weeks ago can die without anyone noticing. So
+/// this asks the person to excuse Sentri from battery saving (the screen most phones hide
+/// behind), and callers re-run it every time the app opens - each fresh schedule outlives
+/// what the system dropped. The schedule itself uses the alarm-clock mode, the one phone
+/// makers promise not to swallow, instead of exact alarms many phones deny by default.
+Future<void> scheduleWaterReminder(int minutes, String title, String body) async {
+  const details = NotificationDetails(
+    android: AndroidNotificationDetails(
+      'sentri_health',
+      'Health',
+      channelDescription: 'Drink-water reminders and gentle heart-rate notes from your own Health tab.',
+      importance: Importance.high,
+      priority: Priority.high,
+      channelShowBadge: true,
+    ),
+    iOS: DarwinNotificationDetails(interruptionLevel: InterruptionLevel.timeSensitive),
+  );
+  try {
+    await _local.cancel(_waterId);
+    if (minutes <= 0) return;
+    final android = _local.resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>();
+    await android?.createNotificationChannel(_healthChannel);
+    await android?.requestNotificationsPermission();
+    // Battery savers on common phone brands silently drop scheduled reminders - the classic
+    // "it never rings at all" case. Ask to be always allowed to run in the background.
+    try {
+      if (!await Permission.ignoreBatteryOptimizations.isGranted) {
+        await Permission.ignoreBatteryOptimizations.request();
+      }
+    } catch (_) {
+      // Only ask when the platform supports the question; a refusal must never block the reminder.
+    }
+    try {
+      await _local.periodicallyShowWithDuration(
+        _waterId,
+        title,
+        body,
+        Duration(minutes: minutes),
+        details,
+        androidScheduleMode: AndroidScheduleMode.alarmClock,
+      );
+    } on PlatformException {
+      // Some phones lock alarm-clock scheduling too: a gently inexact chime still keeps the habit.
+      await _local.periodicallyShowWithDuration(
+        _waterId,
+        title,
+        body,
+        Duration(minutes: minutes),
+        details,
+        androidScheduleMode: AndroidScheduleMode.inexact,
+      );
+    }
+  } catch (_) {
+    // A reminder that cannot be scheduled must never break the Health tab.
+  }
+}
+
+/// A one-off health note (for example a heart-rate warning): same channel as the water
+/// reminder, noticeable but calm, and it replaces the previous note instead of piling up.
+Future<void> showHealthNote(String title, String body) async {
+  try {
+    final android = _local.resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>();
+    await android?.createNotificationChannel(_healthChannel);
+    final android2 = await android?.areNotificationsEnabled() ?? true;
+    if (android2 == false) return;
+    await _local.show(
+      _healthNoteId,
+      title,
+      body,
+      const NotificationDetails(
+        android: AndroidNotificationDetails(
+          'sentri_health',
+          'Health',
+          channelDescription: 'Drink-water reminders and gentle heart-rate notes from your own Health tab.',
+          importance: Importance.high,
+          priority: Priority.high,
+        ),
+        iOS: DarwinNotificationDetails(interruptionLevel: InterruptionLevel.timeSensitive),
+      ),
+    );
+  } catch (_) {
+    // Nothing about health notes may break the app.
+  }
+}
+
+/// Removes the ringing notification of an alert that has been answered or has ended.
+Future<void> cancelAlertNotification(String inboxId) {
+  _stopAlertRepeat();
+  return _local.cancel(inboxId.hashCode & 0x7fffffff);
+}
+
+// ---- an alert does not ring once and die: it nags until someone deals with it ----
+// Some phone makers strip the system "insistent" flag, so the sound and vibration stop
+// after one round. This app does not trust that: while an emergency alert is live and
+// unanswered, the notification is re-issued on a timer, and every re-issue plays the
+// alarm sound and the vibration again. Nothing here is dismissible in between.
+
+Timer? _alertRepeat;
+int? _alertRepeatId;
+int _alertRepeatCount = 0;
+const _alertRepeatEvery = Duration(seconds: 30);
+const _alertRepeatMax = 120; // one hour of insisting, then the phone gets a break
+
+void _stopAlertRepeat() {
+  _alertRepeat?.cancel();
+  _alertRepeat = null;
+  _alertRepeatId = null;
+  _alertRepeatCount = 0;
+}
+
+void _beginAlertRepeat(int id, Map<String, dynamic> data) {
+  _stopAlertRepeat();
+  _alertRepeatId = id;
+  _alertRepeatCount = 0;
+  _alertRepeat = Timer.periodic(_alertRepeatEvery, (_) async {
+    if (_alertRepeatId != id) return; // a newer alert or an end took over
+    _alertRepeatCount++;
+    if (_alertRepeatCount > _alertRepeatMax) return _stopAlertRepeat();
+    try {
+      await _local.show(id, 'Sentri', data['text'] as String?, _urgentDetails());
+    } catch (_) {
+      // A failed ring again must never crash the app; the next tick tries once more.
+    }
+  });
+}
+
+NotificationDetails _urgentDetails() {
+  return NotificationDetails(
+    android: AndroidNotificationDetails(
+      _channel.id,
+      _channel.name,
+      channelDescription: _channel.description,
+      importance: Importance.max,
+      priority: Priority.high,
+      category: AndroidNotificationCategory.alarm,
+      fullScreenIntent: true,
+      enableVibration: true,
+      vibrationPattern: _alarmPattern,
+      visibility: NotificationVisibility.public,
+      audioAttributesUsage: AudioAttributesUsage.alarm,
+      ongoing: true,
+      autoCancel: false,
+      // FLAG_INSISTENT (4): the system itself repeats sound and vibration between re-issues.
+      additionalFlags: Int32List.fromList([4]),
+    ),
+    iOS: const DarwinNotificationDetails(interruptionLevel: InterruptionLevel.timeSensitive),
+  );
+}
+
+/// Shows the alert. The server sends data-only pushes, so the app builds the notification.
+///
+/// An emergency alert (SOS, duress, phone offline) keeps ringing and vibrating until someone deals with it:
+/// the notification is "insistent" (Android repeats its sound and vibration) and cannot be swiped away. It is
+/// removed when a contact taps "I'm responding", when the person cancels, or when the server says it is over.
+Future<void> showAlertNotification(Map<String, dynamic> data) async {
+  final kind = data['kind'];
+  if (kind == 'clear') {
+    _stopAlertRepeat();
+    await _local.cancel(_idFor(data));
+    return;
+  }
+  final text = data['text'];
+  if (text is! String || text.isEmpty) return;
+  if (kind == 'share_start' || kind == 'share_stop') {
+    await _local.show(
+      _idFor(data),
+      'Sentri',
+      text,
+      NotificationDetails(
+        android: AndroidNotificationDetails(_shareChannel.id, _shareChannel.name, channelDescription: _shareChannel.description, importance: Importance.high, priority: Priority.high),
+        iOS: const DarwinNotificationDetails(interruptionLevel: InterruptionLevel.timeSensitive),
+      ),
+    );
+    return;
+  }
+  final urgent = kind == 'sos' || kind == 'duress' || kind == 'offline';
+  final id = _idFor(data);
+  await _local.show(id, 'Sentri', text, urgent ? _urgentDetails() : _shareOnDevice());
+  if (urgent) _beginAlertRepeat(id, data);
+}
+
+NotificationDetails _shareOnDevice() {
+  return NotificationDetails(
+    android: AndroidNotificationDetails(_shareChannel.id, _shareChannel.name, channelDescription: _shareChannel.description, importance: Importance.high, priority: Priority.high),
+    iOS: const DarwinNotificationDetails(interruptionLevel: InterruptionLevel.timeSensitive),
+  );
+}
+
+/// Runs when a push arrives while the app is closed. Must be a top-level function.
+@pragma('vm:entry-point')
+Future<void> sentriBackgroundPush(RemoteMessage m) async {
+  await Firebase.initializeApp();
+  await _local.initialize(const InitializationSettings(android: AndroidInitializationSettings('@drawable/ic_stat_sentri')));
+  final android = _local.resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>();
+  await android?.createNotificationChannel(_channel);
+  await android?.createNotificationChannel(_shareChannel);
+  await showAlertNotification(m.data);
+}
+
+/// Registers for push and keeps the server's copy of this phone's token current.
+///
+/// Push is optional. If the Firebase config files are missing, or the user says no, this logs and
+/// does nothing. Contacts then see alerts only when they open the app.
+class PushService {
+  PushService(this._api, {this.onAlert});
+  final SentriApi _api;
+
+  /// Called when a push arrives while the app is open, so the message bar updates at once.
+  final void Function()? onAlert;
+  StreamSubscription<String>? _refresh;
+  StreamSubscription<RemoteMessage>? _foreground;
+
+  Future<void> start() async {
+    try {
+      await Firebase.initializeApp();
+    } catch (e) {
+      debugPrint('Push disabled: Firebase is not configured ($e)');
+      return;
+    }
+    try {
+      final fm = FirebaseMessaging.instance;
+      await _local.initialize(const InitializationSettings(
+        android: AndroidInitializationSettings('@drawable/ic_stat_sentri'),
+        iOS: DarwinInitializationSettings(),
+      ));
+      await _local.resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>()?.createNotificationChannel(_channel);
+      await _local.resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>()?.createNotificationChannel(_shareChannel);
+      final perm = await fm.requestPermission(alert: true, badge: false, sound: true, criticalAlert: false);
+      if (perm.authorizationStatus == AuthorizationStatus.denied) return;
+
+      FirebaseMessaging.onBackgroundMessage(sentriBackgroundPush);
+      _foreground = FirebaseMessaging.onMessage.listen((m) {
+        unawaited(showAlertNotification(m.data));
+        onAlert?.call();
+      });
+      FirebaseMessaging.onMessageOpenedApp.listen((_) => onAlert?.call());
+
+      final token = await fm.getToken();
+      if (token != null) await _send(token);
+      _refresh = fm.onTokenRefresh.listen((t) => unawaited(_send(t)));
+    } catch (e) {
+      debugPrint('Push setup failed: $e');
+    }
+  }
+
+  Future<void> _send(String token) async {
+    try {
+      await _api.savePushToken(token);
+    } catch (_) {
+      // Offline or signed out: the next start or token refresh tries again.
+    }
+  }
+
+  void dispose() {
+    _refresh?.cancel();
+    _foreground?.cancel();
+  }
+}
