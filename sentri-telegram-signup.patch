new file mode 100644
--- /dev/null
+++ b/mobile/lib/features/health/heart_signal.dart
@@ -0,0 +1,85 @@
+/// Pure signal maths for the fingertip heart-rate reading. No imports at all, so the
+/// maths can be tested without a camera: luminance samples in, one beat rate out.
+///
+/// How it works: blood flowing under the skin changes how much light the finger
+/// reflects. The camera sees that as tiny brightness swings. This file turns those
+/// swings into beats per minute: drop the slow drift, check that the remaining wiggle
+/// is strong enough to trust, then find the swing spacing that best correlates with
+/// itself - that spacing, in seconds, is the beat.
+library;
+
+import 'dart:math' as math;
+
+/// Removes slow drift (lighting changes, the finger pressing in and out): shifts each
+/// sample by the mean of the samples within `window` around it, keeping only the
+/// faster wiggle.
+List<double> detrend(List<double> xs, int window) {
+  final n = xs.length;
+  if (n == 0) return <double>[];
+  final w = window < 1 ? 1 : (window > n ? n : window);
+  final pre = List<double>.filled(n + 1, 0);
+  for (var i = 0; i < n; i++) pre[i + 1] = pre[i] + xs[i];
+  final out = List<double>.filled(n, 0);
+  for (var i = 0; i < n; i++) {
+    var lo = i - w + 1;
+    if (lo < 0) lo = 0;
+    var hi = i + w;
+    if (hi > n) hi = n;
+    out[i] = xs[i] - (pre[hi] - pre[lo]) / (hi - lo);
+  }
+  return out;
+}
+
+/// Estimates the pulse in beats per minute: finds the sample spacing (the "lag")
+/// whose self-correlation is strongest inside the possible heart range, and returns
+/// that spacing in seconds as a rate. Returns null when the signal is too short, too
+/// flat, or too noisy to trust - the app must show "could not read it" rather than
+/// invent a number.
+double? bpmFromSamples(
+  List<double> ys,
+  double fps, {
+  double minBpm = 40,
+  double maxBpm = 180,
+  double trust = 0.22,
+  double minWiggle = 0.35,
+}) {
+  final n = ys.length;
+  if (n < 8 || fps <= 0) return null;
+
+  // Zero-mean.
+  var mean = 0.0;
+  for (final y in ys) mean += y;
+  mean /= n;
+  final z = List<double>.filled(n, 0);
+  for (var i = 0; i < n; i++) z[i] = ys[i] - mean;
+
+  // A real fingertip pulse makes an obvious wiggle in camera counts; flat light means
+  // there is no reading to take.
+  var energy = 0.0;
+  for (final v in z) energy += v * v;
+  final rms = math.sqrt(energy / n);
+  if (rms < minWiggle) return null;
+
+  final minLag = (fps * 60 / maxBpm).floor().clamp(1, n - 1);
+  final maxLag = (fps * 60 / minBpm).ceil().clamp(1, n - 1);
+  if (minLag >= maxLag) return null;
+
+  var r0 = 0.0;
+  for (var i = 0; i < n; i++) r0 += z[i] * z[i];
+
+  var bestLag = -1;
+  var best = 0.0;
+  for (var lag = minLag; lag <= maxLag; lag++) {
+    var s = 0.0;
+    for (var i = 0; i + lag < n; i++) s += z[i] * z[i + lag];
+    if (s > best) {
+      best = s;
+      bestLag = lag;
+    }
+  }
+  if (bestLag < 0 || r0 <= 0) return null;
+  if (best / r0 < trust) return null;
+  final bpm = 60.0 * fps / bestLag;
+  if (bpm < minBpm || bpm > maxBpm) return null;
+  return bpm;
+}
diff --git a/mobile/lib/features/health/heart_camera.dart b/mobile/lib/features/health/heart_camera.dart
new file mode 100644
--- /dev/null
+++ b/mobile/lib/features/health/heart_camera.dart
@@ -0,0 +1,172 @@
+import 'dart:async';
+
+import 'package:camera/camera.dart';
+
+import 'heart_signal.dart';
+
+/// Reads the pulse straight from the person, with no health app in between: the back
+/// camera and its torch, with the fingertip covering both. Each heartbeat pushes a
+/// little more blood through the finger, which changes how much light reflects back -
+/// the camera turns that into a brightness wiggle, and the maths turns the wiggle into
+/// beats per minute.
+///
+/// Deliberately patient and honest: it records about thirty seconds, and returns null
+/// (not a guess) whenever the wiggle is too weak or too messy to trust.
+class HeartCamera {
+  static const secondsTarget = 30;
+
+  /// true after a run that never had a working camera or was not given permission -
+  /// different advice on the screen than "the reading was not strong enough".
+  bool cameraMissing = false;
+
+  final _samples = <double>[];
+  final _times = <double>[];
+  final _sw = Stopwatch();
+  CameraController? _controller;
+
+  /// How many seconds the reading still needs - surfaced so the screen can count down.
+  int secondsLeft = 0;
+
+  /// The live controller while a measurement is on; the screen must show the preview so
+  /// the inner camera keeps sending frames. Null when not measuring.
+  CameraController? get controller => _controller;
+
+  /// Runs one measurement. `onTick` fires about once a second with the seconds left.
+  /// Returns the beats per minute, or null when nothing trustworthy came out.
+  Future<int?> measure({void Function(int secondsLeft)? onTick}) async {
+    await _close();
+    _samples.clear();
+    _times.clear();
+    _sw
+      ..reset()
+      ..start();
+    CameraDescription? cam;
+    cameraMissing = false;
+    try {
+      final cams = await availableCameras();
+      for (final c in cams) {
+        if (c.lensDirection == CameraLensDirection.back) {
+          cam = c;
+          break;
+        }
+      }
+      cam ??= cams.isEmpty ? null : cams.first;
+    } catch (_) {
+      cam = null;
+    }
+    if (cam == null) {
+      cameraMissing = true;
+      return null; // the screen shows the "camera not available" note
+    }
+
+    final ctrl = CameraController(
+      cam,
+      ResolutionPreset.low,
+      enableAudio: false,
+      imageFormatGroup: ImageFormatGroup.yuv420,
+    );
+    try {
+      await ctrl.initialize();
+    } catch (_) {
+      cameraMissing = true; // permission refused, or the camera refuses to open
+      await ctrl.dispose();
+      return null; // never pretend a number
+    }
+    _controller = ctrl;
+    try {
+      await ctrl.setFlashMode(FlashMode.torch);
+    } catch (_) {
+      // A phone without a torch still has a pulse reading chance in bright light.
+    }
+    try {
+      await ctrl.startImageStream(_onFrame);
+    } catch (_) {
+      cameraMissing = true;
+      await _close();
+      return null;
+    }
+
+    final wait = _measureFrames();
+    final total = secondsTarget;
+    while (_sw.elapsed < Duration(seconds: total)) {
+      await Future<void>.delayed(const Duration(milliseconds: 400));
+      final left = total - _sw.elapsed.inSeconds;
+      secondsLeft = left < 0 ? 0 : left;
+      onTick?.call(secondsLeft);
+      if (_sw.elapsed >= Duration(seconds: total)) break;
+    }
+    await wait;
+
+    try {
+      await ctrl.stopImageStream();
+    } catch (_) {}
+    try {
+      await ctrl.setFlashMode(FlashMode.off);
+    } catch (_) {}
+    await _close();
+
+    final n = _samples.length;
+    if (n < 60 || _times.isEmpty) return null;
+    final span = _times.last - _times.first;
+    if (span < 5) return null;
+    final fps = n / span;
+    final ys = detrend(_samples, (fps * 1.5).round().clamp(3, n));
+    final bpm = bpmFromSamples(ys, fps);
+    if (bpm == null) return null;
+    return bpm.round().clamp(30, 220);
+  }
+
+  void _onFrame(CameraImage img) {
+    if (_controller == null) return;
+    if (img.planes.isEmpty || img.width <= 0 || img.height <= 0) return;
+    final p = img.planes.first;
+    final b = p.bytes;
+    final stride = p.bytesPerRow;
+    if (stride < img.width) return;
+    // Centre quarter of the frame: that is where the pressed fingertip sits.
+    final h = img.height, w = img.width;
+    final y0 = h ~/ 4, y1 = h - h ~/ 4 - (h % 2);
+    final x0 = w ~/ 4, x1 = w - w ~/ 4 - (w % 2);
+    if (y1 <= y0 || x1 <= x0) return;
+    var sum = 0;
+    var cnt = 0;
+    for (var y = y0; y < y1; y += 2) {
+      final base = y * stride;
+      for (var x = x0; x < x1; x += 2) {
+        sum += b[base + x];
+        cnt++;
+      }
+    }
+    if (cnt == 0) return;
+    _samples.add(sum / cnt);
+    _times.add(_sw.elapsedMicroseconds / 1e6);
+  }
+
+  /// Waits until the sample buffer stops growing for a beat (the stream has caught up),
+  /// at most a small extra moment past the target window.
+  Future<void> _measureFrames() async {
+    var stable = 0;
+    var lastLen = _samples.length;
+    final limit = DateTime.now().add(const Duration(seconds: 4));
+    while (DateTime.now().isBefore(limit)) {
+      await Future<void>.delayed(const Duration(milliseconds: 120));
+      final len = _samples.length;
+      if (len == lastLen) {
+        stable++;
+      } else {
+        stable = 0;
+        lastLen = len;
+      }
+      if (stable >= 3 && len >= 60) return;
+    }
+  }
+
+  Future<void> _close() async {
+    final c = _controller;
+    _controller = null;
+    if (c == null) return;
+    try {
+      await c.dispose();
+    } catch (_) {}
+  }
+}
