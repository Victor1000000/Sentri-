+  Future<void> _fetchNearby(LatLng here) async {
+    if (_nearBusy) return;
+    _nearBusy = true;
+    try {
+      final list = await NearbyPlaces.fetch(here);
+      list.sort((a, b) {
+        final d = const Distance();
+        return d(here, LatLng(a.lat, a.lon)).compareTo(d(here, LatLng(b.lat, b.lon)));
+      });
+      if (!mounted) return;
