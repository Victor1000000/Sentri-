+  var bestK = -1;
+  var bestMag = -1.0;
+  final band = <double>[];
+  double magAt(int k) => math.sqrt(re[k] * re[k] + im[k] * im[k]);
+  for (var k = kLo; k <= kHi; k++) {
+    final mag = magAt(k);
+    band.add(mag);
+    if (mag > bestMag) {
+      bestMag = mag;
+      bestK = k;
+    }
+  }
+  if (bestK < 0 || bestMag <= 0) return null;
