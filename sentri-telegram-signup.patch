diff --git a/mobile/lib/features/map/nearby_places.dart b/mobile/lib/features/map/nearby_places.dart
new file mode 100644
--- /dev/null
+++ b/mobile/lib/features/map/nearby_places.dart
@@ -0,0 +1,100 @@
+import 'dart:convert';
+
+import 'package:http/http.dart' as http;
+import 'package:latlong2/latlong.dart';
+
+/// One business or landmark around the person, straight from OpenStreetMap.
+class NearbyPlace {
+  const NearbyPlace({required this.name, required this.kind, required this.lat, required this.lon});
+  final String name;
+  final String kind; // grocery, hotel, gym, hospital...
+  final double lat;
+  final double lon;
+}
+
+/// Live "what is around me" from the free OpenStreetMap Overpass service: hotels, malls,
+/// gyms, markets, small shops, hospitals, fuel stations, banks. No key, no cost.
+class NearbyPlaces {
+  /// [parseOverpass] is pure so it can be tested without a network.
+  static Future<List<NearbyPlace>> fetch(LatLng at, {double radiusM = 700, http.Client? client}) async {
+    final q = '[out:json][timeout:25];('
+        'node(around:$radiusM,${at.latitude},${at.longitude})["amenity"];'
+        'node(around:$radiusM,${at.latitude},${at.longitude})["shop"];'
+        'node(around:$radiusM,${at.latitude},${at.longitude})["tourism"];'
+        'node(around:$radiusM,${at.latitude},${at.longitude})["leisure"];'
+        'way(around:$radiusM,${at.latitude},${at.longitude})["amenity"];'
+        'way(around:$radiusM,${at.latitude},${at.longitude})["shop"];'
+        'way(around:$radiusM,${at.latitude},${at.longitude})["tourism"];'
+        'way(around:$radiusM,${at.latitude},${at.longitude})["leisure"];'
+        ');out center 40;';
+    final uri = Uri.parse('https://overpass-api.de/api/interpreter');
+    final res = await (client ?? http.Client()).post(uri, body: {'data': q}, headers: const {'User-Agent': 'Sentri/0.1'});
+    if (res.statusCode != 200) return const <NearbyPlace>[];
+    return parseOverpass(res.body);
+  }
+
+  /// Names a place in everyday words from its OSM tags.
+  static String kindLabel(Map<String, String> tags) {
+    String? pick(String key, {bool shorten = true}) {
+      final v = tags[key];
+      if (v == null || v.isEmpty) return null;
+      if (!shorten) return v;
+      return switch (v) {
+        'fitness_centre' || 'sports_centre' => 'gym',
+        'marketplace' => 'market',
+        'supermarket' || 'convenience' || 'kiosk' || 'greengrocer' || 'bakery' || 'butcher' || 'clothes' || 'mobile_phone' || 'electronics' => 'shop',
+        'fast_food' || 'cafe' || 'restaurant' || 'bar' => v == 'fast_food' ? 'food' : v,
+        'guest_house' || 'hostel' => 'hotel',
+        'fuel' => 'petrol',
+        'clinic' || 'doctors' || 'dentist' => 'hospital',
+        'public_service' => 'office',
+        _ => v,
+      };
+    }
+
+    return pick('shop') ?? pick('amenity') ?? pick('tourism') ?? pick('leisure') ?? 'place';
+  }
+
+  /// Turns an Overpass JSON answer into named places, junk filtered out.
+  static List<NearbyPlace> parseOverpass(String body) {
+    List<NearbyPlace>? out;
+    try {
+      final j = jsonDecode(body) as Map<String, dynamic>;
+      final elements = (j['elements'] ?? const <dynamic>[]) as List<dynamic>;
+      out = <NearbyPlace>[];
+      for (final rawEl in elements) {
+        final el = rawEl as Map<String, dynamic>;
+        final tags = (el['tags'] ?? const <String, dynamic>{}) as Map<String, dynamic>;
+        final name = tags['name'];
+        if (name == null || '$name'.trim().isEmpty) continue;
+        final strTags = tags.map<String, String>((k, v) => MapEntry(k, '$v'));
+        final amenity = strTags['amenity'];
+        // Street furniture is not a nearby place a person wants to know about.
+        const junk = {'parking', 'parking_entrance', 'parking_space', 'bench', 'waste_basket', 'toilets', 'shelter', 'vending_machine', 'bicycle_parking', 'phone', 'atm', 'public_bookcase', 'recycling', 'grave_yard'};
+        if (amenity != null && junk.contains(amenity)) continue;
+        double lat;
+        double lon;
+        if (el['type'] == 'node') {
+          lat = (el['lat'] as num).toDouble();
+          lon = (el['lon'] as num).toDouble();
+        } else {
+          final c = el['center'] as Map<String, dynamic>?;
+          if (c == null) continue;
+          lat = (c['lat'] as num).toDouble();
+          lon = (c['lon'] as num).toDouble();
+        }
+        out!.add(NearbyPlace(name: '$name'.trim(), kind: kindLabel(strTags), lat: lat, lon: lon));
+      }
+    } catch (_) {
+      return const <NearbyPlace>[];
+    }
+    // Duplicates: the same shop can be node and way. Keep one per name per ~10 m.
+    final kept = <NearbyPlace>[];
+    final d = const Distance();
+    for (final p in out!) {
+      final same = kept.any((k) => k.name.toLowerCase() == p.name.toLowerCase() && d(LatLng(k.lat, k.lon), LatLng(p.lat, p.lon)) < 12);
+      if (!same) kept.add(p);
+    }
+    return kept;
+  }
+}
diff --git a/mobile/lib/features/map/step_voice.dart b/mobile/lib/features/map/step_voice.dart
new file mode 100644
--- /dev/null
+++ b/mobile/lib/features/map/step_voice.dart
@@ -0,0 +1,35 @@
+import 'dart:async';
+
+import 'package:flutter_tts/flutter_tts.dart';
+
+/// Speaks route instructions with the phone's own voice engine. Chosen over a bundled or
+/// generated voice on purpose: it is free, needs no data connection, and every Android phone
+/// already has one installed (Google TTS) - exactly what an emergency app should lean on.
+class StepVoice {
+  final _tts = FlutterTts();
+  bool _ready = false;
+
+  Future<void> _ensure() async {
+    if (_ready) return;
+    await _tts.setLanguage('en-US');
+    await _tts.setSpeechRate(0.5);
+    await _tts.setVolume(1.0);
+    await _tts.setQueueMode(1); // wait for the previous line instead of cutting it
+    _ready = true;
+  }
+
+  Future<void> say(String text) async {
+    try {
+      await _ensure();
+      await _tts.speak(text);
+    } catch (_) {
+      // A missing voice engine must never break the map.
+    }
+  }
+
+  Future<void> stop() async {
+    try {
+      await _tts.stop();
+    } catch (_) {}
+  }
+}
diff --git a/mobile/test/nearby_places_test.dart b/mobile/test/nearby_places_test.dart
new file mode 100644
--- /dev/null
+++ b/mobile/test/nearby_places_test.dart
@@ -0,0 +1,56 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:latlong2/latlong.dart';
+
+import 'package:sentri/features/map/nearby_places.dart';
+
+void main() {
+  test('parseOverpass keeps named businesses and drops street furniture', () {
+    const body = '''
+{"elements":[
+ {"type":"node","id":1,"lat":6.45,"lon":3.39,"tags":{"name":"Mega Plaza","shop":"electronics"}},
+ {"type":"way","id":2,"lat":0,"lon":0,"center":{"lat":6.46,"lon":3.40},"tags":{"name":" Ikeja City Mall ","shop":"mall"}},
+ {"type":"node","id":3,"lat":6.47,"lon":3.41,"tags":{"name":"Bodyline Gym","leisure":"fitness_centre"}},
+ {"type":"node","id":4,"lat":6.48,"lon":3.42,"tags":{"name":"Guest Lodge","tourism":"hotel"}},
+ {"type":"node","id":5,"lat":6.49,"lon":3.43,"tags":{"amenity":"bench"}},
+ {"type":"node","id":6,"lat":6.50,"lon":3.44,"tags":{"amenity":"fuel"}},
+ {"type":"node","id":7,"lat":6.51,"lon":3.45}
+]}
+''';
+    final places = NearbyPlaces.parseOverpass(body);
+    final names = [for (final p in places) p.name];
+    expect(names, contains('Mega Plaza'));
+    expect(names, contains('Ikeja City Mall')); // trimmed
+    expect(names, contains('Bodyline Gym'));
+    expect(names, contains('Guest Lodge'));
+    expect(names, contains('fuel')); // amenity without a name keeps the tag word
+    expect(names, isNot(contains('bench')),
+        reason: 'benches, bins, parking and the like are not what a person is navigating to');
+    final mall = places.firstWhere((p) => p.name == 'Ikeja City Mall');
+    expect(mall.lat, 6.46);
+    expect(mall.lon, 3.40);
+    expect(mall.kind, 'shop');
+    final gym = places.firstWhere((p) => p.name == 'Bodyline Gym');
+    expect(gym.kind, 'gym');
+    final hotel = places.firstWhere((p) => p.name == 'Guest Lodge');
+    expect(hotel.kind, 'hotel');
+  });
+
+  test('parseOverpass survives broken input and dedupes the same shop', () {
+    expect(NearbyPlaces.parseOverpass('not json'), isEmpty);
+    expect(NearbyPlaces.parseOverpass('{"elements": []}'), isEmpty);
+    const dup = '''
+{"elements":[
+ {"type":"node","id":1,"lat":6.45,"lon":3.39,"tags":{"name":"X Bar","amenity":"bar"}},
+ {"type":"way","id":2,"center":{"lat":6.4500001,"lon":3.3900001},"tags":{"name":"X Bar","amenity":"bar"}}
+]}
+''';
+    expect(NearbyPlaces.parseOverpass(dup).length, 1);
+  });
+
+  test('kindLabel maps everyday kinds', () {
+    expect(NearbyPlaces.kindLabel({'leisure': 'fitness_centre'}), 'gym');
+    expect(NearbyPlaces.kindLabel({'shop': 'marketplace'}), 'market');
+    expect(NearbyPlaces.kindLabel({'tourism': 'guest_house'}), 'hotel');
+    expect(NearbyPlaces.kindLabel({'amenity': 'fuel'}), 'petrol');
+  });
+}
