     : undefined;
 retention?.start();
 
+// ---- stuck-alert sweeper (Postgres mode) ----
+// Activation and repeat timers live in memory (or the queue); if the backend restarts mid-alert the
+// timer can be lost, and the alert row then stays countdown/active forever -- which keeps blocking
+// contact changes for that user. At boot and every 5 minutes, finish any live alert that has
+// outlived the longest life the repeat loop could ever give it (maxRepeats x repeatMs, with a
+// generous grace for slow boots and queue hiccups). Cancelled/acknowledged alerts are untouched.
+if (pool) {
+  const db = pool;
+  const maxLiveMs = Math.max(env.MAX_REPEATS * env.REPEAT_INTERVAL_MS, env.CANCEL_WINDOW_MS) + 10 * 60_000;
+  const expireStale = async () => {
+    const cut = clock() - maxLiveMs;
+    const r = await db.query(
+      `UPDATE sos_events SET state = 'expired', ended_at = $1 WHERE state IN ('countdown','active') AND started_at < $2`,
+      [clock(), cut],
+    );
+    const n = r.rowCount ?? 0;
+    if (n > 0) log.info({ expired: n }, 'stale live alerts expired by sweeper');
+  };
+  await expireStale();
+  setInterval(() => void expireStale().catch((e) => log.error({ err: e instanceof Error ? e.message : 'unknown' }, 'stale alert sweep failed')), 5 * 60_000).unref();
+}
 await app.listen({ port: env.PORT, host: '0.0.0.0' });
 log.info({ port: env.PORT, store: env.STORE }, 'sentri backend listening');
 
