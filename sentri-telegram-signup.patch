+                      Container(width: 10, height: 10, decoration: BoxDecoration(shape: BoxShape.circle, border: Border.all(color: const Color(0xFF6A5FF0), width: 3))),
+                      const SizedBox(width: 8),
+                      Expanded(
+                        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+                          Text(_route!.destName, maxLines: 1, overflow: TextOverflow.ellipsis, style: const TextStyle(fontSize: 14.5, fontWeight: FontWeight.w700)),
+                          Text(t('map.route_info', {'km': _route!.kmText, 'min': _route!.minText}), style: TextStyle(fontSize: 12.5, color: cs.onSurface.withValues(alpha: 0.6))),
+                        ]),
+                      ),
+                      IconButton(
+                        tooltip: t('map.route_steps'),
+                        onPressed: _showSteps,
+                        icon: const Icon(Icons.list, size: 22, color: Color(0xFF6A5FF0)),
+                      ),
+                      IconButton(
+                        tooltip: _voiceOn ? t('map.voice_off') : t('map.voice_on'),
+                        onPressed: _toggleVoice,
+                        icon: _voiceOn ? const Icon(Icons.volume_up, size: 22, color: Color(0xFF6A5FF0)) : const Icon(Icons.volume_off_outlined, size: 22, color: Color(0xFF6A5FF0)),
+                      ),
+                      IconButton(
+                        tooltip: t('map.clear_point'),
+                        onPressed: _clearPoints,
+                        icon: Icon(Icons.close, size: 22, color: cs.onSurface.withValues(alpha: 0.6)),
+                      ),
+                    ]),
+                  ],
+                  if (_route == null && (f?.accuracyM ?? 0) > 100) ...[
+                    const SizedBox(height: 6),
+                    Text(t('map.approx_hint'), style: TextStyle(fontSize: 12, height: 1.3, color: cs.onSurface.withValues(alpha: 0.65))),
+                    Row(children: [
+                      TextButton(onPressed: () => unawaited(Geolocator.openLocationSettings()), child: Text(t('map.open_location_settings'))),
+                      TextButton(onPressed: () => unawaited(Geolocator.openAppSettings()), child: Text(t('map.open_app_settings'))),
+                    ]),
+                  ],
+                ]),
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/mobile/lib/app.dart b/mobile/lib/app.dart
new file mode 100644
--- /dev/null
+++ b/mobile/lib/app.dart
@@ -0,0 +1,197 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:latlong2/latlong.dart';
+
+import 'core/theme.dart';
+import 'core/widgets/brand.dart';
+import 'core/widgets/glass.dart';
+import 'package:flutter/services.dart' show rootBundle;
+
+import 'features/home/home_screen.dart';
+import 'features/location/place_lookup.dart';
+import 'features/map/map_screen.dart';
+import 'features/police/police_directory.dart';
+import 'features/police/police_screen.dart';
+import 'features/health/health_screen.dart';
+import 'features/onboarding/onboarding_controller.dart';
+import 'features/onboarding/onboarding_screens.dart';
+import 'features/sos/sos_controller.dart';
+import 'features/sos/sos_screen.dart';
+import 'services.dart';
+
+class SentriApp extends StatelessWidget {
+  const SentriApp({super.key, required this.services});
+  final AppServices services;
+
+  @override
+  Widget build(BuildContext context) {
+    return ValueListenableBuilder<ThemeMode>(
+      valueListenable: ThemeChoice.mode,
+      builder: (context, mode, _) => MaterialApp(
+      title: 'Sentri',
+      debugShowCheckedModeBanner: false,
+      // Flutter's own widgets only need a locale they support; app text comes from I18n,
+      // which also covers Pidgin (not a Flutter-supported locale).
+      locale: const Locale('en'),
+      theme: sentriTheme(Brightness.light),
+      darkTheme: sentriTheme(Brightness.dark),
+      themeMode: mode,
+      // Text a little smaller than the platform default. The person's own system font-size setting still applies.
+      builder: (context, child) => MediaQuery(
+        data: MediaQuery.of(context).copyWith(textScaler: TextScaler.linear((MediaQuery.of(context).textScaler.scale(1) * 0.92).clamp(0.8, 1.6))),
+        child: child!,
+      ),
+      home: _Root(services: services),
+    ));
+  }
+}
+
+class _Root extends StatefulWidget {
+  const _Root({required this.services});
+  final AppServices services;
+  @override
+  State<_Root> createState() => _RootState();
+}
+
+class _RootState extends State<_Root> {
+  SosPhase _last = SosPhase.idle;
+  bool _splash = true;
+
+  @override
+  void initState() {
+    super.initState();
+    widget.services.sos.addListener(_onSos);
+    Future<void>.delayed(const Duration(milliseconds: 1500), () {
+      if (mounted) setState(() => _splash = false);
+    });
+  }
+
+  @override
+  void dispose() {
+    widget.services.sos.removeListener(_onSos);
+    super.dispose();
+  }
+
+  /// When an alert ends by PIN, say "Alert cancelled". A duress PIN lands here too, because the
+  /// controller reports idle for it: the two are indistinguishable on screen by design.
+  void _onSos() {
+    final now = widget.services.sos.phase;
+    final endedByPin = (_last == SosPhase.countdown || _last == SosPhase.active) && now == SosPhase.idle;
+    _last = now;
+    if (endedByPin && mounted) {
+      ScaffoldMessenger.of(context)
+        ..hideCurrentSnackBar()
+        ..showSnackBar(SnackBar(content: Text(widget.services.i18n.t('sos.cancelled'))));
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final s = widget.services;
+    if (_splash) return const SplashView();
+    return Stack(
+      children: [
+        Positioned.fill(
+          child: ListenableBuilder(
+            listenable: Listenable.merge([s.sos, s.onboarding, s.settings, s.i18n]),
+            builder: (context, _) {
+              final onboarded = s.settings.onboarded && s.onboarding.step == OnboardingStep.done;
+              if (!onboarded) {
+                return OnboardingFlow(c: s.onboarding, i18n: s.i18n, bridge: s.bridge);
+              }
+              return Stack(
+                children: [
+                  _Tabs(services: s),
+                  if (s.sos.phase != SosPhase.idle) Positioned.fill(child: SosScreen(sos: s.sos, i18n: s.i18n, police: s.police)),
+                ],
+              );
+            },
+          ),
+        ),
+
+      ],
+    );
+  }
+}
+
+
+/// Home, Map, Health and Police. The pages stay built inside an IndexedStack, so directions, pins and
+/// route voice plans survive a switch to Home and back.
+class _Tabs extends StatefulWidget {
+  const _Tabs({required this.services});
+  final AppServices services;
+  @override
+  State<_Tabs> createState() => _TabsState();
+}
+
+class _TabsState extends State<_Tabs> {
+  int _tab = 0;
+  PoliceDirectory? _directory;
+  Future<PoliceDirectory>? _directoryFuture;
+  String? _state;
+
+  /// The live Map tab's state, so the Health tab can ask it to plan a route to a
+  /// nearby hospital or gym with one tap - the map is already built and warm.
+  final GlobalKey<MapScreenState> _mapKey = GlobalKey<MapScreenState>();
+
+  @override
+  void initState() {
+    super.initState();
+    // The same parsed directory backs the Police tab and aims the map's directions at the closest
+    // command's post. Loading it once here keeps both users on one parse.
+    _directoryFuture = rootBundle.loadString('assets/directory/police_directory.json').then((raw) => PoliceDirectory.parse(raw));
+    unawaited(_directoryFuture!.then((d) {
+      if (mounted) setState(() => _directory = d);
+    }));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final s = widget.services;
+    final t = s.i18n.t;
+    // All tabs stay built inside an IndexedStack, so switching to Home and back no longer
+    // tears down the Map tab: an active route, its pin and its voice plan survive the switch.
+    final body = IndexedStack(
+      index: _tab,
+      children: [
+        HomeScreen(sos: s.sos, settings: s.settings, i18n: s.i18n, bridge: s.bridge, api: s.api, inbox: s.inbox, share: s.share, checkin: s.checkin, police: s.police, people: s.people),
+        MapScreen(key: _mapKey, location: s.location, api: s.api, i18n: s.i18n, placeLookup: const DevicePlaceLookup(), onPlace: (p) => _state = p?.state, police: _directoryFuture),
+        HealthScreen(
+          health: s.health,
+          i18n: s.i18n,
+          exercise: s.exercise,
+          awards: s.awards,
+          checkin: s.checkin,
+          onRoute: (place) {
+            // Tap a hospital or gym in the Health tab: the map plans the route to it
+            // and the app switches to the Map tab, which is already warm.
+            _mapKey.currentState?.routeTo(LatLng(place.lat, place.lon), place.name);
+            setState(() => _tab = 1);
+          },
+        ),
+        PoliceScreen(directory: _directory, i18n: s.i18n, currentState: _state),
+      ],
+    );
+    return Scaffold(
+      body: body,
+      bottomNavigationBar: Glass(
+       radius: 0,
+       blur: 24,
+       child: NavigationBar(
+        height: 68,
+        indicatorColor: Brand.indigo,
+        backgroundColor: Colors.transparent,
+        elevation: 0,
+        selectedIndex: _tab,
+        onDestinationSelected: (i) => setState(() => _tab = i),
+        destinations: [
+          NavigationDestination(icon: const Icon(Icons.home_outlined), selectedIcon: const Icon(Icons.home, color: Colors.white), label: t('tabs.home')),
+          NavigationDestination(icon: const Icon(Icons.map_outlined), selectedIcon: const Icon(Icons.map, color: Colors.white), label: t('tabs.map')),
+          NavigationDestination(icon: const Icon(Icons.monitor_heart_outlined), selectedIcon: const Icon(Icons.monitor_heart, color: Colors.white), label: t('tabs.health')),
+          NavigationDestination(icon: const Icon(Icons.local_police_outlined), selectedIcon: const Icon(Icons.local_police, color: Colors.white), label: t('tabs.police')),
+        ],
+      )),
+    );
+  }
+}
diff --git a/mobile/lib/services.dart b/mobile/lib/services.dart
new file mode 100644
--- /dev/null
+++ b/mobile/lib/services.dart
@@ -0,0 +1,249 @@
+import 'dart:async';
+import 'dart:io' show Platform;
+
+import 'package:connectivity_plus/connectivity_plus.dart';
+import 'package:flutter/foundation.dart' show ValueListenable;
+import 'package:flutter/services.dart' show rootBundle;
+
+import 'core/config.dart';
+import 'core/i18n/i18n.dart';
+import 'core/net/api.dart';
+import 'core/platform/native_bridge.dart';
+import 'core/settings.dart';
+import 'core/theme.dart';
+import 'core/storage/key_value_store.dart';
+import 'core/timers.dart';
+import 'features/battery/battery.dart';
+import 'features/battery/low_battery_alerter.dart';
+import 'features/checkin/checkin_controller.dart';
+import 'features/health/health_controller.dart';
+import 'features/health/awards.dart';
+import 'features/health/exercise_controller.dart';
+import 'features/inbox/inbox_controller.dart';
+import 'features/location/location.dart';
+import 'features/police/police_directory.dart';
+import 'features/share/share_controller.dart';
+import 'features/onboarding/onboarding_controller.dart';
+import 'features/push/push_service.dart';
+import 'features/sos/contact_people.dart';
+import 'features/sos/local_pin_vault.dart';
+import 'features/sos/sos_controller.dart';
+
+/// Builds and wires everything once at start-up.
+class AppServices {
+  AppServices._({
+    required this.store,
+    required this.session,
+    required this.api,
+    required this.i18n,
+    required this.bridge,
+    required this.vault,
+    required this.contacts,
+    required this.people,
+    required this.settings,
+    required this.sos,
+    required this.lowBattery,
+    required this.health,
+    required this.awards,
+    required this.exercise,
+    required this.onboarding,
+    required this.location,
+    required this.inbox,
+    required this.share,
+    required this.checkin,
+    required this.waking,
+  });
+
+  final KeyValueStore store;
+  final Session session;
+  final SentriApi api;
+  final I18n i18n;
+  final NativeBridge bridge;
+  final LocalPinVault vault;
+  final ContactStore contacts;
+
+  /// Names and drawn guardian characters for the contacts (saved on this phone only).
+  final ContactPeople people;
+  final AppSettings settings;
+  final SosController sos;
+  final LowBatteryAlerter lowBattery;
+
+  /// The Health tab's watch: heart-rate readings, drink-water reminders, nearby hospitals and gyms.
+  final HealthController health;
+
+  /// Exercise awards: the badges earned for milestones and broken records.
+  final AwardStore awards;
+
+  /// The exercise engine: live walk/run/bike tracking with steps, distance and history.
+  final ExerciseController exercise;
+
+  final OnboardingController onboarding;
+  final LocationSource location;
+  final InboxController inbox;
+  final ShareController share;
+
+  /// The "Check on me" watch: a timed safety check that raises a full alert when missed.
+  final CheckInController checkin;
+
+  /// True while the app waits for a sleeping server to wake up.
+  final ValueListenable<bool> waking;
+
+  /// The police directory, loaded once; the SOS screen and alert screens use it to show who to call.
+  final Future<PoliceDirectory> police = rootBundle.loadString('assets/directory/police_directory.json').then(PoliceDirectory.parse);
+  StreamSubscription<List<ConnectivityResult>>? _net;
+  late final PushService _push = PushService(api, onAlert: () => unawaited(inbox.refresh()));
+
+  static Future<AppServices> create() async {
+    final store = SecureKeyValueStore();
+    final session = Session(store);
+    await session.load();
+    final settings = AppSettings(store);
+    await settings.load();
+    ThemeChoice.mode.value = ThemeChoice.parse(settings.theme);
+    ThemeChoice.persist = (n) => settings.update(theme: n);
+
+    final i18n = I18n();
+    await i18n.init(settings.language);
+
+    final httpApi = HttpSentriApi(baseUrl: AppConfig.safeApiBaseUrl, session: session);
+    final SentriApi api = httpApi;
+    final bridge = MethodChannelBridge();
+    final vault = LocalPinVault(store);
+    final contacts = ContactStore(store);
+    final people = ContactPeople(store);
+    const timers = RealTimers();
+    final location = GeolocatorSource();
+    final battery = BatteryPlusSource();
+
+    final sos = SosController(
+      api: api,
+      vault: vault,
+      location: location,
+      battery: battery,
+      timers: timers,
+      pending: store,
+      dataSaver: () => settings.dataSaver,
+    );
+
+    final inbox = InboxController(
+      api,
+      onOver: cancelAlertNotification,
+      onUrgent: (e) => showAlertNotification({'kind': e.kind, 'text': e.text, 'inboxId': e.id}),
+    );
+    final share = ShareController(api: api, location: location, battery: battery, timers: timers, store: store, dataSaver: () => settings.dataSaver);
+
+    final checkin = CheckInController(sos: sos, timers: timers, store: store);
+
+    final lowBattery = LowBatteryAlerter(
+      api: api,
+      battery: battery,
+      location: location,
+      timers: timers,
+    );
+
+    final health = HealthController(
+      api: api,
+      settings: settings,
+      location: location,
+      i18n: i18n,
+    );
+
+    final awards = AwardStore(store);
+    final exercise = ExerciseController(store: store, location: location, awards: awards);
+
+    final onboarding = OnboardingController(
+      api: api,
+      session: session,
+      keyStore: store,
+      vault: vault,
+      contacts: contacts,
+      settings: settings,
+      bridge: bridge,
+      countryCode: AppConfig.defaultCountryCode,
+      platform: Platform.isIOS ? 'ios' : 'android',
+    );
+    // If the server says it no longer knows this phone, start sign-in again instead of failing quietly.
+    httpApi.onSessionExpired = () => unawaited(onboarding.sessionExpired());
+    await onboarding.resume();
+
+    final s = AppServices._(
+      store: store,
+      session: session,
+      api: api,
+      i18n: i18n,
+      bridge: bridge,
+      vault: vault,
+      contacts: contacts,
+      people: people,
+      settings: settings,
+      sos: sos,
+      lowBattery: lowBattery,
+      health: health,
+      awards: awards,
+      exercise: exercise,
+      onboarding: onboarding,
+      location: location,
+      inbox: inbox,
+      share: share,
+      checkin: checkin,
+      waking: httpApi.waking,
+    );
+    // Start waking a sleeping server now, so it is ready by the time the person taps anything.
+    unawaited(httpApi.prewarm());
+    await s._start();
+    return s;
+  }
+
+  Future<void> _start() async {
+    // OS-level triggers (Android: shake, volume, power, floating button, quick-settings tile;
+    // iOS: App Intent / Shortcut) arrive here.
+    // An alert that never reached the server (phone restarted, app killed) is sent first of all.
+    if (settings.onboarded) unawaited(sos.resumePending());
+    // The moment a connection returns, a waiting alert goes out instead of waiting for the next retry.
+    _net = Connectivity().onConnectivityChanged.listen((r) {
+      if (r.any((c) => c != ConnectivityResult.none)) {
+        sos.networkRestored();
+        final a = api;
+        if (a is HttpSentriApi) unawaited(a.prewarm());
+        unawaited(inbox.refresh());
+      }
+    });
+    bridge.onTrigger((t) => unawaited(sos.trigger(t.name)));
+    final pending = await bridge.takePendingTrigger();
+    if (pending != null) unawaited(sos.trigger(pending.name));
+    // A "check on me" window armed before the app last closed re-arms (or fires if it just ended).
+    if (settings.onboarded) unawaited(checkin.resume());
+
+    // Protection is the app's whole purpose: the triggers stay armed even when the session has
+    // slipped (for example after the server restarted), so help always works.
+    await bridge.startProtection(settings.triggers);
+    if (settings.onboarded) {
+      lowBattery.start();
+      health.start();
+      unawaited(exercise.load());
+      unawaited(awards.load());
+      unawaited(_push.start());
+      unawaited(inbox.refresh());
+      unawaited(share.resume());
+    }
+    settings.addListener(() {
+      if (settings.onboarded) {
+        lowBattery.start();
+        health.start();
+        unawaited(_push.start());
+      }
+    });
+
+  }
+
+  Future<void> dispose() async {
+    await _net?.cancel();
+    lowBattery.stop();
+    health.dispose();
+    exercise.dispose();
+    awards.dispose();
+    checkin.dispose();
+    sos.dispose();
+    share.dispose();
+  }
+}
