# Copy to .env and fill in. NEVER commit real values.
NODE_ENV=development
PORT=8080
# Use a SHORT domain: link length drives SMS cost (160 chars = 1 segment).
PUBLIC_BASE_URL=http://localhost:8080

# Generate each with: openssl rand -hex 32
TOKEN_SECRET=
PIN_PEPPER=
JWT_SECRET=
# 64 hex chars each. DATA_KEY encrypts phone numbers / push tokens; PHONE_HMAC_KEY builds the lookup index.
# Keep these in a secret manager, NOT in the database. Losing DATA_KEY makes stored numbers unrecoverable.
DATA_KEY=
PHONE_HMAC_KEY=

# Storage: memory (dev, nothing persists) | postgres (needs DATABASE_URL + REDIS_URL)
STORE=memory
DATABASE_URL=postgres://sentri:sentri@localhost:5432/sentri
REDIS_URL=redis://localhost:6379
DEFAULT_COUNTRY_CODE=234
# Reverse proxies in front of the server (most hosting platforms: 1). Needed so rate limits see each caller's real IP.
TRUST_PROXY_HOPS=0
GLOBAL_RATE_PER_MIN=600

# Alert loop
CANCEL_WINDOW_MS=5000
REPEAT_INTERVAL_MS=25000
MAX_REPEATS=240
OFFLINE_AFTER_MS=90000
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MS=300000
RETENTION_HOURS=72

# SMS (mock | termii)
SMS_PROVIDER=mock
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd
# Placeholders: set from your actual Termii rate card.
SMS_COST_KOBO_ESTIMATE=500
SMS_DAILY_BUDGET_KOBO=5000000
SMS_EMERGENCY_RESERVE_PCT=20
SMS_PER_USER_DAILY_KOBO=50000

# Police routing: log_only until an MOU / verified official SMS lines exist
DISPATCH_MODE=log_only
DISPATCH_INCLUDE_USER_PHONE=true

# Dev only (refused in production): demo user (cancel PIN 1234, duress PIN 4321) and printing OTP codes to the console
DEV_SEED=false
OTP_DEV_ECHO=false

# --- Place names (optional). Host Nominatim yourself, in the same region as this API. ---
# GEOCODER=nominatim
# NOMINATIM_URL=http://nominatim:8080

# --- Push notifications (optional). Contacts who have the app get a push as well as SMS. ---
# PUSH_PROVIDER=fcm
# FCM_SERVICE_ACCOUNT_B64=   # base64 of the Firebase service-account JSON: base64 -w0 service-account.json

# --- Admin API (optional). Must differ from TOKEN_SECRET and JWT_SECRET. ---
# ADMIN_JWT_SECRET=      # openssl rand -hex 32
