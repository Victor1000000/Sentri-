{
  "name": "sentri-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run test/pg.integration.test.ts",
    "admin:create": "tsx src/admin-cli.ts",
    "sms:test": "tsx src/sms-test-cli.ts"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}